# From @BotFather
TELEGRAM_BOT_TOKEN=
# From https://my.telegram.org -> API development tools
API_ID=
API_HASH=
# Run `node generate_session.js` once on your PC with the ASSISTANT account's phone number
SESSION_STRING=
# YouTube Data API v3 key from Google Cloud console
GOOGLE_DATA_API_KEY=

# --- Optional ---
# Only needed on Windows/local runs if ffmpeg/yt-dlp are not on PATH
# FFMPEG_PATH=C:\ffmpeg\bin
# YTDLP_PATH=C:\path\to\yt-dlp.exe
# Path to a cookies.txt exported from a browser logged in to YouTube.
# Use this if downloads fail with "Sign in to confirm you're not a bot".
# YTDLP_COOKIES=/app/cookies.txt
# Set to false to stop the bot from also posting the mp3 file in the chat
# SEND_AUDIO_FILE=true
